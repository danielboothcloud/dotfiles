# Slim, secret-free dev container: fd, ripgrep, kubectl, tuicr, pi + neovim (with this repo's
# configs), rootless podman, and mise with the global config applied but its
# tools not installed (run `mise install` inside the container to reconcile).
#
# Build from the repo root (the build context must be the whole chezmoi source):
#   podman build -f packages/container/Containerfile -t dotfiles .
#   # optional: avoid GitHub API rate limits while mise resolves "latest"
#   podman build -f packages/container/Containerfile --secret id=github_token,env=GITHUB_TOKEN -t dotfiles .
#
# Run:
#   podman run --rm -it --userns=keep-id:uid=10001,gid=10001 -e COLORTERM=truecolor \
#     --device /dev/fuse --security-opt label=disable \
#     -v "$PWD:/home/danielbooth/work" -w /home/danielbooth/work dotfiles
#
# Rootless Podman works inside the container (Podman-in-Podman, no --privileged;
# see https://www.redhat.com/en/blog/podman-inside-container). It needs
# /dev/fuse (fuse-overlayfs storage) and SELinux separation disabled, as shown above.
# Inner storage lives in an anonymous volume at ~/.local/share/containers; mount a
# named one to keep pulled images between runs: -v podman-storage:/home/danielbooth/.local/share/containers
#
# Run as an osewa host (https://osewa.dev) — sshd is only used once to enroll:
#   podman run -d --name devbox --userns=keep-id:uid=10001,gid=10001 \
#     --device /dev/fuse --security-opt label=disable \
#     -p 2222:22 -p 7322:7322/tcp -p 7322:7322/udp \
#     -e SSH_AUTHORIZED_KEYS="$(cat ~/.ssh/id_ed25519.pub)" \
#     -v osewa:/home/danielbooth/.config/osewa \
#     -v "$PWD:/home/danielbooth/work" dotfiles osewa-serve
#   # ~/.ssh/config on the client:  Host devbox / HostName <server> / Port 2222 / User danielbooth
#   osewa login --no-install devbox && osewa attach devbox

# The Sundae session sandbox image (OpenShell, git, jj, osewa, user `sandbox` 10001).
# Bump to the newest sha-<short> tag of ghcr.io/danielboothcloud/sundae-sandbox.
ARG SANDBOX_BASE=ghcr.io/danielboothcloud/sundae-sandbox:sha-5463b2e

# dojo (jj helper) from its develop branch; only the binary goes into the image.
FROM docker.io/library/rust:1-slim-trixie AS dojo
RUN cargo install --locked --git https://github.com/danielboothcloud/dojo --branch develop dojo --root /out

FROM ${SANDBOX_BASE}

ARG USERNAME=danielbooth
# NOTE: Sundae pods run as the base image's `sandbox` user (10001:10001), so this user
# shares its ids; `sandbox` stays first in /etc/passwd, keeping HOME=/sandbox for Sundae.
ARG UID=10001

# sundae-sandbox ends as USER 10001 with a PATH lacking sbin; system setup needs root.
USER root
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

# ── System packages (Fedora repos) ────────────────────────────────────────────
# gcc/make/tree-sitter-cli build nvim-treesitter parsers; unzip/tar/xz unpack Mason and mise downloads.
RUN dnf -y install --setopt=install_weak_deps=False \
      ripgrep fd-find chezmoi git \
      gcc make tree-sitter-cli unzip tar gzip xz curl ca-certificates \
      glibc-langpack-en libatomic ncurses-term sudo \
      openssh-server \
      podman crun fuse-overlayfs \
      --exclude container-selinux \
 && dnf clean all \
 && curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# Upstream kubectl: Fedora's package name is versioned (kubernetes1.xx-client).
ARG TARGETARCH
RUN v="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" \
 && url="https://dl.k8s.io/release/${v}/bin/linux/${TARGETARCH:-amd64}/kubectl" \
 && curl -fsSLo /usr/local/bin/kubectl "${url}" \
 && echo "$(curl -fsSL "${url}.sha256")  /usr/local/bin/kubectl" | sha256sum -c - \
 && chmod 755 /usr/local/bin/kubectl \
 && kubectl version --client

# rtk: pi-aio's hypa rewrites shell commands (ls, cat, find, rg) to `rtk ...`; without it they exit 127.
# Pinned with the SHA-256 values from the release's checksums.txt.
ARG RTK_VERSION=1.2.1
RUN case "${TARGETARCH:-amd64}" in \
      amd64) triple=x86_64-unknown-linux-musl; sum=75f64525711be935657a6b228d929c24bd9d1ab7d640ea374a8b913e5b5bac05 ;; \
      arm64) triple=aarch64-unknown-linux-musl; sum=cae1a911eda9e898dbb90039436e9d53922b20afb1e3e4ae341f749eb62b7781 ;; \
      *) echo "rtk: unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSLo /tmp/rtk.tgz "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-${triple}.tar.gz" \
 && echo "${sum}  /tmp/rtk.tgz" | sha256sum -c - \
 && tar -xzf /tmp/rtk.tgz -C /usr/local/bin rtk \
 && chmod 755 /usr/local/bin/rtk \
 && rm -f /tmp/rtk.tgz \
 && rtk --version

COPY --from=dojo /out/bin/dojo /usr/local/bin/dojo
RUN dojo --version

# ── sshd (key-only, for `osewa login` enrollment) ─────────────────────────────
# pam_loginuid fails in containers; host keys are generated at container start.
RUN sed -i 's/^session\s\+required\s\+pam_loginuid.so/session optional pam_loginuid.so/' /etc/pam.d/sshd \
 && printf '%s\n' 'PasswordAuthentication no' 'KbdInteractiveAuthentication no' 'PermitRootLogin no' \
      > /etc/ssh/sshd_config.d/10-container.conf

# Kept as a file (not a heredoc): buildah on GitHub's Ubuntu runners lacks heredoc support.
COPY packages/container/osewa-serve /usr/local/bin/osewa-serve

# sudoers matches by uid (#N): getpwuid(10001) resolves to `sandbox`, not ${USERNAME}.
RUN useradd --non-unique --uid "${UID}" --gid "${UID}" --no-user-group \
      --create-home --shell /bin/bash "${USERNAME}" \
 && usermod -p '*' "${USERNAME}" \
 && install -d -m 700 -o "${UID}" -g "${UID}" "/home/${USERNAME}/.config" "/home/${USERNAME}/.config/osewa" \
 && echo "#${UID} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"

# Sundae sets HOME=/sandbox, and osewa keys its state off XDG_CONFIG_HOME, so these must
# not be image ENV; login shells (incl. osewa sessions' `sh -l`) read them from here.
RUN printf '%s\n' \
      "# dotfiles: configs and tools live in /home/${USERNAME}, even when HOME=/sandbox." \
      ": \"\${XDG_CONFIG_HOME:=/home/${USERNAME}/.config}\"; export XDG_CONFIG_HOME" \
      ": \"\${XDG_DATA_HOME:=/home/${USERNAME}/.local/share}\"; export XDG_DATA_HOME" \
      ": \"\${GIT_TERMINAL_PROMPT:=0}\"; export GIT_TERMINAL_PROMPT" \
      "# osewa sessions start without the image PATH; tuicr, nvim and node are linked here." \
      "case \":\${PATH}:\" in *\":/home/${USERNAME}/.local/bin:\"*) ;; *) PATH=\"/home/${USERNAME}/.local/bin:\${PATH}\"; export PATH ;; esac" \
      > /etc/profile.d/dotfiles.sh
COPY packages/container/mise-volume.sh /etc/profile.d/mise-volume.sh

# ── Podman-in-Podman (rootless), modelled on quay.io/podman/stable ────────────
# - newuidmap/newgidmap lose their file caps in Fedora base images; restore them.
#   Kata's virtio-fs drops security.* xattrs, so also set setuid (mode bits survive).
# - subuid/subgid ranges cover every UID except ${UID} inside the 65536 IDs the
#   outer rootless container gets with --userns=keep-id.
# - fuse-overlayfs storage: kernel overlay-on-overlay is usually refused.
RUN rpm --setcaps shadow-utils 2>/dev/null \
 && chmod 4755 /usr/bin/newuidmap /usr/bin/newgidmap \
 && printf '%s\n' "root:1:65535" "${UID}:1:$((UID - 1))" "${UID}:$((UID + 1)):$((65535 - UID))" \
      | tee /etc/subuid > /etc/subgid \
 && sed -e 's|^#mount_program|mount_program|g' \
        -e 's|^mountopt[[:space:]]*=.*$|mountopt = "nodev,fsync=0"|g' \
        /usr/share/containers/storage.conf > /etc/containers/storage.conf \
 && for d in .config/containers .local .local/bin .local/share .local/share/containers; do \
      install -d -o "${UID}" -g "${UID}" "/home/${USERNAME}/$d"; \
    done
COPY packages/container/containers.conf /etc/containers/containers.conf
COPY packages/container/podman-storage.sh /etc/profile.d/podman-storage.sh
COPY packages/container/session-env.sh /etc/profile.d/session-env.sh
COPY --chown=${UID}:${UID} packages/container/podman-containers.conf /home/${USERNAME}/.config/containers/containers.conf
# chroot isolation lets `podman build` run nested.
ENV _CONTAINERS_USERNS_CONFIGURED="" \
    BUILDAH_ISOLATION=chroot

# Static (non-secret) env normally set by conf.d/env.fish, which is skipped.
# GIT_TERMINAL_PROMPT=0: no agent can answer a git credential prompt; fail at once, not hang.
ENV LANG=en_US.UTF-8 \
    DOTFILES_CONTAINER=1 \
    EDITOR=nvim \
    VISUAL=nvim \
    DISABLE_TELEMETRY=true \
    DISABLE_AUTOUPDATER=1 \
    ESSENTIAL_TRAFFIC_ONLY=1 \
    PI_CACHE_RETENTION=long \
    MISE_YES=1 \
    GIT_TERMINAL_PROMPT=0

# Numeric: group 10001 is named `sandbox`, and there is no `danielbooth` group.
USER ${UID}:${UID}
ENV HOME=/home/${USERNAME}
ENV PI_CODING_AGENT_DIR=${HOME}/.config/pi \
    PATH=${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH}
WORKDIR ${HOME}

# ── pi + neovim runtime (node, pi, neovim, tuicr via mise) ────────────────────
# NOTE: exposed via ~/.local/bin links, not shims: shims fail until the global mise
# config's tools are installed. `mise install` later recreates shims, which take precedence.
# Up to 3 attempts: GitHub release fetches sometimes fail with HTTP 403 in CI (rate limit).
RUN --mount=type=secret,id=github_token,required=false \
    export GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" MISE_HTTP_RETRIES=5; \
    for i in 1 2 3; do \
      mise install node@latest pi@latest neovim@latest github:agavra/tuicr@latest && break; \
      [ "$i" = 3 ] && exit 1; echo "mise install failed (attempt $i); retrying in 30s"; sleep 30; \
    done \
 && ln -sf "$(mise where node@latest)"/bin/* "${HOME}/.local/bin/" \
 && ln -sf "$(find "$(mise where pi@latest)" -maxdepth 2 -type f -name pi -perm -u+x | head -1)" "${HOME}/.local/bin/pi" \
 && ln -sf "$(find "$(mise where neovim@latest)" -maxdepth 3 -type f -path '*/bin/nvim' | head -1)" "${HOME}/.local/bin/nvim" \
 && ln -sf "$(find "$(mise where github:agavra/tuicr@latest)" -maxdepth 3 -type f -name tuicr -perm -u+x | head -1)" "${HOME}/.local/bin/tuicr" \
 && rm -rf "${HOME}/.local/share/mise/shims" \
 && nvim --version >/dev/null && tuicr --version && command -v node npm pi

# ── pi + neovim configs ───────────────────────────────────────────────────────
COPY --chown=${UID}:${UID} . ${HOME}/.local/share/chezmoi
RUN chezmoi apply --no-tty --force --exclude=scripts "${HOME}/.config/pi" "${HOME}/.config/nvim"
# Default jj identity in sessions; Sundae's per-repo config (e.g. a GitLab email) still wins.
RUN install -d -m 700 "${HOME}/.config/jj" \
 && printf '%s\n' '[user]' 'name = "Daniel Booth"' 'email = "user@danielbooth.cloud"' \
      > "${HOME}/.config/jj/config.toml"

RUN nvim --headless '+Lazy! sync' +qa \
 && nvim --headless '+MasonToolsInstallSync' +qa \
 && nvim --headless \
      -c "lua require('nvim-treesitter').install({'bash','c','diff','html','lua','luadoc','markdown','markdown_inline','query','vim','vimdoc','fish','json','yaml','toml','go','python','typescript'}):wait(600000)" \
      +qa
# Non-fatal: pi retries missing packages on first start.
RUN pi update --extensions || echo "warning: pi package install failed; pi will retry on start"
# `hypa` on PATH for shells and older pi-aio builds (before 8d532ff only the first `hypa` of a
# rewritten command got the full path). Its .so files resolve via the real path.
RUN h="$(ls "${PI_CODING_AGENT_DIR}"/git/github.com/danielboothcloud/pi-aio/node_modules/@hypabolic/hypa-linux-*/bin/hypa 2>/dev/null | head -1)" \
 && if [ -n "${h}" ]; then ln -sf "${h}" "${HOME}/.local/bin/hypa" && hypa --version; \
    else echo "warning: pi-aio's hypa binary not found; hypa is not on PATH"; fi

# Global mise config last, so the build never resolves its (uninstalled) tools.
# mise.lock isn't tracked, so the dry run resolves "latest" and fails the build on an invalid config.
RUN --mount=type=secret,id=github_token,required=false \
    export GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)"; \
    chezmoi apply --no-tty --force --exclude=scripts "${HOME}/.config/mise" \
 && mise install --dry-run

# Inner Podman storage must not sit on the image's overlay filesystem.
# Declared last: RUN steps can't modify a path once it's a VOLUME.
VOLUME ${HOME}/.local/share/containers

WORKDIR ${HOME}/work
EXPOSE 22/tcp 7322/tcp 7322/udp
CMD ["bash", "-l"]
