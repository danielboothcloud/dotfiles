{
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@upstash/context7-pi",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "git:github.com/danielboothcloud/pi-aio@feature/ui2"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openrouter/z-ai/glm-5.3",
    "openrouter/typesafe/jev-router",
    "synthetic/hf:deepseek-ai/DeepSeek-V4.1-Flash",
    "synthetic/hf:zai-org/GLM-5.3-Flash"
  ],
  "aio": {
    "browserSearch": {
      "provider": "exa",
      "exa": {
        "apiKeyEnv": "EXA_API_KEY",
        "searchType": "auto"
      }
    },
    "statusLine": {
      "enabled": true,
      "segments": [
        "mode",
        "path",
        "git",
        "context",
        "effort",
        "statuses",
        "cursor",
        "quota",
        "model"
      ],
      "path": "basename",
      "workingMessage": "minimal",
      "providerUsage": {
        "refreshIntervalMs": 60000,
        "timeoutMs": 5000,
        "providers": {
          "synthetic": {
            "endpoint": "https://api.synthetic.new/v2/quotas",
            "headers": {
              "Authorization": "Bearer ${SYNTHETIC_API_KEY}"
            },
            "windows": {
              "fivehour": {
                "label": "5h",
                "mapping": {
                  "remaining": "rollingFiveHourLimit.remaining",
                  "limit": "rollingFiveHourLimit.max"
                }
              },
              "weekly": {
                "label": "wk",
                "mapping": {
                  "text": "weeklyTokenLimit.remainingCredits"
                }
              }
            }
          }
        }
      }
    }
  },
  "theme": "dark",
  "hideThinkingBlock": true
}