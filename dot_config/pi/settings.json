{
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@upstash/context7-pi",
    "npm:@gotgenes/pi-anthropic-auth",
    "git:github.com/danielboothcloud/pi-aio@fix/goals"
  ],
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "synthetic/hf:zai-org/GLM-5.3-Flash",
    "anthropic/claude-fable-5-2",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-haiku-5-5"
  ],
  "aio": {
    "browserSearch": {
      "provider": "exa",
      "fetchProvider": "exa",
      "exa": {
        "apiKeyEnv": "EXA_API_KEY",
        "searchType": "auto"
      }
    },
    "statusLine": {
      "enabled": true,
      "segments": [
        "mode",
        "path",
        "git",
        "context",
        "effort",
        "statuses",
        "cursor",
        "quota",
        "model"
      ],
      "path": "basename",
      "workingMessage": "minimal",
      "providerUsage": {
        "refreshIntervalMs": 60000,
        "timeoutMs": 5000,
        "providers": {
          "anthropic": {
            "endpoint": "https://api.anthropic.com/api/oauth/usage",
            "auth": "pi-oauth",
            "refreshIntervalMs": 300000,
            "windows": {
              "fiveHour": {
                "label": "5h",
                "mapping": {
                  "usedPercent": "five_hour.utilization",
                  "renewsAt": "five_hour.resets_at"
                }
              },
              "sevenDay": {
                "label": "7d",
                "mapping": {
                  "usedPercent": "seven_day.utilization",
                  "renewsAt": "seven_day.resets_at"
                }
              }
            }
          },
          "synthetic": {
            "endpoint": "https://api.synthetic.new/v2/quotas",
            "headers": {
              "Authorization": "Bearer ${SYNTHETIC_API_KEY}"
            },
            "windows": {
              "weekly": {
                "label": "wk",
                "mapping": {
                  "remainingPercent": "planWeeklyLimit.percentRemaining",
                  "renewsAt": "planWeeklyLimit.nextRegenAt"
                }
              }
            }
          }
        }
      }
    }
  },
  "theme": "dark",
  "hideThinkingBlock": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.9",
    "{\"source\":\"npm:@gotgenes/pi-anthropic-auth\",\"scope\":\"user\"}": "3.4.4"
  }
}