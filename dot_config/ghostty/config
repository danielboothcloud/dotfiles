font-family = MesloLGS Nerd Font Mono
font-size = 17
background-opacity = 1
theme = Rose Pine

# Detect URLs in terminal output and open them with Command-click on macOS.
link-url = true

# Send Option as Alt so terminal keybinds receive Alt instead of macOS special characters.
macos-option-as-alt = true

keybind = shift+enter=text:\n

# Let Zellij handle Command shortcuts instead of Ghostty.
keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+c=unbind
keybind = cmd+w=unbind
keybind = cmd+k=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+f=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+opt+left=unbind
keybind = cmd+opt+right=unbind
keybind = cmd+opt+up=unbind
keybind = cmd+opt+down=unbind
# Cmd+1..9 go to Zellij tabs. Unbind does not forward these: with Cmd held
# they are not printable. Send the Kitty sequence for Super+digit instead.
# 49 is "1"; the modifier 9 is Super.
keybind = cmd+digit_1=csi:49;9u
keybind = cmd+1=csi:49;9u
keybind = cmd+digit_2=csi:50;9u
keybind = cmd+2=csi:50;9u
keybind = cmd+digit_3=csi:51;9u
keybind = cmd+3=csi:51;9u
keybind = cmd+digit_4=csi:52;9u
keybind = cmd+4=csi:52;9u
keybind = cmd+digit_5=csi:53;9u
keybind = cmd+5=csi:53;9u
keybind = cmd+digit_6=csi:54;9u
keybind = cmd+6=csi:54;9u
keybind = cmd+digit_7=csi:55;9u
keybind = cmd+7=csi:55;9u
keybind = cmd+digit_8=csi:56;9u
keybind = cmd+8=csi:56;9u
keybind = cmd+digit_9=csi:57;9u
keybind = cmd+9=csi:57;9u

# Cmd+R runs `atuin resume` (agent-session picker) in Zellij/fish. Ghostty sends
# ^X^R (0x18 0x12), which fish binds to the _atuin_ai_resume widget. The widget
# only exists at the shell prompt, so running apps are unaffected.
keybind = cmd+r=text:\x18\x12

shell-integration = fish
