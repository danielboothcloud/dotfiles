#!/bin/bash
# Shared fzf session picker for Ghostty startup and Zellij Option+S.
set -uo pipefail
picker_dir=$(cd -- "$(dirname -- "$0")" && pwd)

list_sessions() {
    python3 "$picker_dir/session-picker-ids.py"
}

preview_session() {
    local session="$1" tab pane own_pane=""
    printf 'Session: %s\n\n' "$session"
    if [[ "$session" == "${ZELLIJ_SESSION_NAME:-}" ]]; then
        own_pane="${ZELLIJ_PANE_ID:-}"
    fi
    tab=$(zellij --session "$session" action list-tabs --json 2>/dev/null |
        jq -r '[.[] | select(.active)][0].tab_id // empty')
    pane=$(zellij --session "$session" action list-panes --json 2>/dev/null |
        jq -c --arg tab "$tab" --arg own "$own_pane" '
            [.[] | select(.is_plugin == false and .exited != true)
             | select((.id | tostring) != $own)]
            | sort_by([((.tab_id | tostring) == $tab), .is_focused])
            | last // empty')
    if [[ -z "$pane" ]]; then
        printf 'No terminal preview available.\n'
        return
    fi
    printf '%s\n\n' "$(jq -r '.title' <<< "$pane")"
    zellij --session "$session" action dump-screen --ansi \
        --pane-id "terminal_$(jq -r '.id' <<< "$pane")" 2>/dev/null ||
        printf 'Session is no longer available.\n'
}

if [[ "${1:-}" == --preview ]]; then
    preview_session "$2"
    exit
fi

for dependency in zellij fzf jq python3; do
    command -v "$dependency" >/dev/null || {
        printf 'Session picker requires %s.\n' "$dependency" >&2
        exit 1
    }
done

sessions=$(list_sessions) || exit 1
if [[ "${1:-}" == --list ]]; then
    [[ -z "$sessions" ]] || printf '%s\n' "$sessions"
    exit 0
fi
if [[ "${1:-}" == --switch ]]; then
    # Cmd+N inside Zellij: switch to the running session labelled N.
    [[ "${2:-}" =~ ^[0-9]$ && -n "${ZELLIJ:-}" ]] || exit 0
    target=$(awk -F'\t' -v n="$2" '$1 == n { sub(/^[^\t]*\t/, ""); print; exit }' <<< "$sessions")
    [[ -n "$target" && "$target" != "${ZELLIJ_SESSION_NAME:-}" ]] || exit 0
    exec zellij action switch-session "$target"
fi
if [[ -z "$sessions" ]]; then
    if [[ -z "${ZELLIJ:-}" ]]; then
        exec zellij
    fi
    exit 0
fi

picker_options=(--header='Type a number or name | Enter: switch | Esc: cancel' --no-preview)
if [[ -z "${ZELLIJ:-}" ]]; then
    printf -v script_path '%q' "$0"
    picker_options=(
        --header='Type a number or name | Enter: attach | Esc: cancel | Ctrl-R: refresh preview'
        --preview="/bin/bash $script_path --preview {2..}"
        --preview-window='right:65%:nowrap'
        --bind='ctrl-r:refresh-preview'
    )
fi
selection=$(printf '%s\n' "$sessions" |
    FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= fzf \
        --height=100% --layout=reverse --border --no-multi \
        --prompt='Session > ' --delimiter=$'\t' --nth=1,2.. --accept-nth=2.. \
        --with-shell='/bin/bash -c' \
        --bind='change:transform:case "$FZF_QUERY" in [0-9]) echo "change-nth(1)";; *) echo "change-nth(1,2..)";; esac' \
        "${picker_options[@]}") || exit 0
[[ -n "$selection" ]] || exit 0

if [[ -n "${ZELLIJ:-}" ]]; then
    [[ "$selection" == "${ZELLIJ_SESSION_NAME:-}" ]] && exit 0
    zellij action switch-session "$selection"
else
    exec zellij attach "$selection"
fi
