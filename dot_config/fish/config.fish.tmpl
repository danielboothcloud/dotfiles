{{ if eq .chezmoi.os "darwin" -}}
fish_add_path /opt/homebrew/bin
fish_add_path /opt/homebrew/sbin
fish_add_path /opt/homebrew/share/google-cloud-sdk/bin
{{ else if eq .chezmoi.os "linux" -}}
fish_add_path /home/linuxbrew/.linuxbrew/bin
fish_add_path /home/linuxbrew/.linuxbrew/sbin
{{ end -}}
fish_add_path $HOME/bin
fish_add_path $HOME/.local/bin
fish_add_path /usr/local/bin
fish_add_path $HOME/go/bin
fish_add_path $HOME/.local/share/pnpm/bin
fish_add_path $HOME/.krew/bin

# Environment variables
set -gx GOBIN $HOME/go/bin
set -gx PNPM_HOME $HOME/.local/share/pnpm
set -gx UV_PYTHON (mise which python)
{{ if eq .chezmoi.os "linux" -}}
# Headless: route BROWSER to OSC 8 hyperlink printer (Ghostty makes it clickable)
set -gx BROWSER $HOME/bin/clickable
{{ end -}}

# Inside an SSH session, prefer ghostty terminfo if the remote has it,
# else fall back to xterm-256color
if test -n "$SSH_CONNECTION"
  if infocmp ghostty &>/dev/null
    set -gx TERM ghostty
  else
    set -gx TERM xterm-256color
  end
end

set -g fish_greeting

if status is-interactive
  # Ghostty: choose an active Zellij session with a right-hand preview.
  if test "$TERM" = xterm-ghostty; and not set -q ZELLIJ
    set -gx ZELLIJ_CONFIG_DIR $HOME/.config/zellij
    /bin/bash "$HOME/.config/zellij/session-picker"
  end

  function ssh --wraps=ssh
    if test (count $argv) -ge 1; and test "$argv[1]" = opl-bastion
      if not ssh-add -l 2>/dev/null | string match -qr 'PIV AUTH'
        ssh-add -s /usr/local/lib/opensc-pkcs11.so; or return 1
      end
    end
    # ghostty terminfo is not on remote hosts
    if test "$TERM" = ghostty -o "$TERM" = xterm-ghostty
      env TERM=xterm-256color command ssh $argv
    else
      command ssh $argv
    end
  end

{{- if eq .chezmoi.os "darwin" }}
  # Auto-eternal-terminal into bluefin (eternaloff / eternalon to toggle persistently)
  alias eternaloff='touch ~/.no-autoet; and echo "auto-et disabled"'
  alias eternalon='rm -f ~/.no-autoet; and echo "auto-et enabled"'

  if test -z "$SSH_CONNECTION"; and not test -e ~/.no-autoet
    et bluefin-vm
  end
{{- end }}

  starship init fish | source
  fzf --fish | source
  atuin init fish | source
  zoxide init fish --cmd cd | source

  function __fish_startup_tip --on-event fish_prompt
    # Add new tips here; one is chosen at random for each interactive shell.
    set -l tips \
      'Zellij: press Ctrl-G to unlock, then E to open Yazi.' \
      'Zellij: press Cmd-Shift-F to show or hide floating panes, even while locked.' \
      'Yazi: press s to search for files with fd.' \
      'Atuin: press ? at the shell prompt to open the AI modal.' \
      'Zoxide: run cdi to fuzzy-find a directory.' \
      'Fish: run fvi to fuzzy-pick files to open in Neovim.' \
      'Zellij: press Ctrl-G, then S to open the session picker.' \
      'Atuin: press Tab to edit a selected command; Enter runs it.' \
      'Neovim: press Space, then cd to open Yazi at the current file.' \
      'Neovim: press Space, then gg to open Lazygit.' \
      'Neovim: press Space Space to find files; Space rg searches contents.' \
      'Neovim: press Space gf to open the current file’s Git history.' \
      'Neovim: press Space mr to toggle rendered Markdown.' \
      'Neovim: press Tab / Shift-Tab to cycle buffers.' \
      'Zellij: press Ctrl-G, then P, then E to switch the current pane between tiled and floating.' \
      'Zellij: press Ctrl-G, then T, then B to move the current pane into its own tab.' \
      'Ghostty: Cmd-click a URL to open it from terminal output.' \
      'Clones: run clones to browse remote and local repositories.' \
      'Fish: px expands to pnpm dlx.' \
      'Kubernetes: run kube to toggle the Kubernetes context in your Starship prompt.' \
      'Neovim: press Space gb to open Git Browse.' \
      'Neovim: ciw replaces the word under your cursor.' \
      'Neovim: ci" / ci( replaces everything inside quotes or parentheses.' \
      'Neovim: dap deletes the current paragraph.' \
      'Neovim: . repeats your last edit.' \
      'Neovim: >> / << indents or unindents a line.' \
      'Neovim: f<char> jumps to a character on the line; ; repeats, , reverses.' \
      'Neovim: % jumps between matching brackets.' \
      'Neovim: * searches for the word under your cursor; n finds the next match.' \
      'Neovim: Ctrl-O jumps back to your previous location.' \
      'Neovim: g; jumps to your previous edit location.' \
      'Neovim: gv reselects your last visual selection.' \
      'Neovim: Ctrl-A / Ctrl-X increments or decrements a number.'
    printf '── Tip: %s ──\n' (random choice $tips)
    functions -e __fish_startup_tip
  end
end

mise activate fish | source
