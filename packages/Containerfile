# Portable, secret-free container of this dotfiles setup (fish, starship, mise,
# neovim, pi, tuicr, zellij, yazi, lazygit, kubectl/k9s/helm).
#
# Build from the repo root (the build context must be the whole chezmoi source):
#   podman build -f packages/Containerfile -t dotfiles .
#   # optional: avoid GitHub API rate limits while mise resolves "latest"
#   podman build -f packages/Containerfile --secret id=github_token,env=GITHUB_TOKEN -t dotfiles .
#
# Run:
#   podman run --rm -it --userns=keep-id -e COLORTERM=truecolor \
#     -v "$PWD:/home/danielbooth/work" -w /home/danielbooth/work dotfiles
#
# Secret-bearing chezmoi templates (1Password) are skipped via the
# DOTFILES_CONTAINER block in .chezmoiignore; no secrets are baked in.

ARG FEDORA_VERSION=43
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS tools

ARG USERNAME=danielbooth
ARG UID=1000

# ── System packages (Fedora repos) ────────────────────────────────────────────
RUN dnf -y install --setopt=install_weak_deps=False \
      fish git git-lfs chezmoi \
      ripgrep fd-find bat fzf eza zoxide atuin btop jq \
      gcc make tree-sitter-cli unzip tar gzip xz curl ca-certificates \
      python3 procps-ng less which findutils file ncurses-term \
      glibc-langpack-en libatomic sudo \
 && dnf clean all \
 && curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# ── Non-secret git defaults (dot_gitconfig.tmpl is skipped: it reads 1Password)
# Set your email at runtime: -e GIT_AUTHOR_EMAIL=... -e GIT_COMMITTER_EMAIL=...
RUN git config --system user.name "Daniel Booth" \
 && git config --system push.autoSetupRemote true \
 && git config --system pull.rebase true \
 && git config --system core.excludesfile '~/.gitignore_global' \
 && git lfs install --system

RUN useradd --create-home --uid "${UID}" --shell /usr/bin/fish "${USERNAME}" \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"

# Static (non-secret) env normally set by conf.d/env.fish, which is skipped.
ENV LANG=en_US.UTF-8 \
    DOTFILES_CONTAINER=1 \
    EDITOR=nvim \
    VISUAL=nvim \
    DISABLE_TELEMETRY=true \
    DISABLE_AUTOUPDATER=1 \
    ESSENTIAL_TRAFFIC_ONLY=1 \
    AWS_PAGER="" \
    PI_CACHE_RETENTION=long \
    MISE_YES=1 \
    MISE_DISABLE_TOOLS="awscli,azure-cli,azure-kubelogin,gcloud,minikube,podman,pipx,pipx:podman-compose"

USER ${USERNAME}
ENV HOME=/home/${USERNAME}
ENV XDG_CONFIG_HOME=${HOME}/.config \
    PI_CODING_AGENT_DIR=${HOME}/.config/pi \
    PATH=${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${HOME}/bin:${PATH}
WORKDIR ${HOME}

# ── mise tools: host config (minus disabled cloud tools) + container extras ───
# Copied ahead of the full repo so editing other dotfiles doesn't bust this layer.
COPY packages/container/mise.toml /etc/mise/config.toml
COPY --chown=${USERNAME} dot_config/mise/config.toml ${HOME}/.config/mise/config.toml
RUN --mount=type=secret,id=github_token,required=false \
    export GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)"; \
    mise install node \
 && mise install \
 && mise reshim

# ── Dotfiles ──────────────────────────────────────────────────────────────────
FROM tools AS dotfiles
ARG USERNAME=danielbooth

COPY --chown=${USERNAME} . ${HOME}/.local/share/chezmoi
RUN chezmoi apply --no-tty --force --exclude=scripts

# Post-apply setup that the run_once scripts / first launch would normally do.
RUN fish -c 'curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher update'
RUN nvim --headless '+Lazy! sync' +qa \
 && nvim --headless '+MasonToolsInstallSync' +qa \
 && nvim --headless \
      -c "lua require('nvim-treesitter').install({'bash','c','diff','html','lua','luadoc','markdown','markdown_inline','query','vim','vimdoc','fish','json','yaml','toml','go','python','typescript'}):wait(600000)" \
      +qa
# Non-fatal: pi and yazi retry missing packages on first start.
RUN pi update --extensions || echo "warning: pi package install failed; pi will retry on start"
RUN ya pkg install || echo "warning: yazi package install failed"

WORKDIR ${HOME}/work
CMD ["fish", "-l"]
