{{ if eq .chezmoi.os "darwin" -}}
fish_add_path /opt/homebrew/bin
fish_add_path /opt/homebrew/sbin
fish_add_path /opt/homebrew/share/google-cloud-sdk/bin
{{ else if eq .chezmoi.os "linux" -}}
fish_add_path /home/linuxbrew/.linuxbrew/bin
fish_add_path /home/linuxbrew/.linuxbrew/sbin
{{ end -}}
fish_add_path $HOME/bin
fish_add_path $HOME/.local/bin
fish_add_path /usr/local/bin
fish_add_path $HOME/go/bin
fish_add_path $HOME/.local/share/pnpm/bin
fish_add_path $HOME/.krew/bin

# Environment variables
set -gx GOBIN $HOME/go/bin
set -gx PNPM_HOME $HOME/.local/share/pnpm
set -gx UV_PYTHON $HOME/.local/share/mise/installs/python/3.14.8/bin/python3
{{ if eq .chezmoi.os "linux" -}}
# Headless: route BROWSER to OSC 8 hyperlink printer (Ghostty makes it clickable)
set -gx BROWSER $HOME/bin/clickable
{{ end -}}

# Inside an SSH session, prefer ghostty terminfo if the remote has it,
# else fall back to xterm-256color
if test -n "$SSH_CONNECTION"
  if infocmp ghostty &>/dev/null
    set -gx TERM ghostty
  else
    set -gx TERM xterm-256color
  end
end

set -g fish_greeting

if status is-interactive
  # Ghostty: choose an active Zellij session with a right-hand preview.
  if test "$TERM" = xterm-ghostty; and not set -q ZELLIJ
    set -gx ZELLIJ_CONFIG_DIR $HOME/.config/zellij
    /bin/bash "$HOME/.config/zellij/session-picker"
  end

  function ssh --wraps=ssh
    if test (count $argv) -ge 1; and test "$argv[1]" = opl-bastion
      if not ssh-add -l 2>/dev/null | string match -qr 'PIV AUTH'
        ssh-add -s /usr/local/lib/opensc-pkcs11.so; or return 1
      end
    end
    # ghostty terminfo is not on remote hosts
    if test "$TERM" = ghostty -o "$TERM" = xterm-ghostty
      env TERM=xterm-256color command ssh $argv
    else
      command ssh $argv
    end
  end

  starship init fish | source
  fzf --fish | source
  atuin init fish | source
  # Ghostty Cmd+R sends ^X^R; run `atuin resume` exactly as if typed at the
  # prompt (uses config.toml [threads] settings). The _atuin_ai_resume widget
  # would force --keymap-mode=emacs + --shell-widget, overriding config.
  bind \cx\cr 'atuin resume; commandline -f repaint'
  zoxide init fish --cmd cd | source

  # Startup tip from ~/.config/fish/tips.txt (also shown in the zjstatus bar).
  # At most one tip per fish_tip_interval seconds (default 2700 = 45 min),
  # across all shells. Skipped in agent shells, SSH, dumb or narrow terminals.
  function __fish_startup_tip --on-event fish_prompt
    functions -e __fish_startup_tip

    set -l tips_file $HOME/.config/fish/tips.txt
    test -r $tips_file; or return
    # Agent harnesses: Pi, Claude Code, Codex, OpenCode, Gemini CLI, Cursor
    for var in PI_CODING_AGENT CLAUDECODE CODEX_SANDBOX OPENCODE GEMINI_CLI CURSOR_AGENT
      set -q $var; and return
    end
    set -q SSH_CONNECTION; or set -q SSH_TTY; or set -q SSH_CLIENT; and return
    test "$TERM" = dumb; and return
    test $COLUMNS -lt 60; and return

    set -l now (date +%s)
    set -q fish_tip_interval; or set -l fish_tip_interval 2700
    if set -q __fish_tip_last_shown
      test (math $now - $__fish_tip_last_shown) -lt $fish_tip_interval; and return
    end
    set -U __fish_tip_last_shown $now

    set -l tips (string match -rv '^\s*(#|$)' < $tips_file)
    test (count $tips) -gt 0; or return
    printf '── Tip: %s ──\n' (random choice $tips)
  end
end

mise activate fish | source
